{
  "theme": "Cybersecurity News",
  "feeds_file": "cybersecurity_feeds.json",
  "sources": [
    "Major cybersecurity news outlets (BleepingComputer, The Hacker News, CISA advisories, Krebs on Security)"
  ],
  "constraints": {
    "max_items": 5,
    "time_window": "target_date"
  },
  "dedup": {
    "reports_dir": "../../../my-docs/security-news",
    "days": 7
  },
  "boundary_default": "keep",
  "insufficient_fallback": "reduce",
  "fetchable_min_chars": 600,
  "browser_fallback": false,
  "model": "gemini-3.8-flash-low",
  "effort": "low",
  "template_path": "../../../my-docs/templates/cybersecurity_news_template.md"
}
